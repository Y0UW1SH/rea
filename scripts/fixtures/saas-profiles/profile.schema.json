{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rea/saas-product-profile-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "product": {
          "$ref": "#/$defs/fact"
        },
        "edition": {
          "$ref": "#/$defs/fact"
        },
        "region": {
          "$ref": "#/$defs/fact"
        },
        "version": {
          "$ref": "#/$defs/fact"
        },
        "workspace": {
          "$ref": "#/$defs/fact"
        },
        "role": {
          "$ref": "#/$defs/fact"
        },
        "currency": {
          "$ref": "#/$defs/fact"
        },
        "locale": {
          "$ref": "#/$defs/fact"
        },
        "timezone": {
          "$ref": "#/$defs/fact"
        }
      },
      "required": [
        "product",
        "edition",
        "region",
        "version",
        "workspace",
        "role",
        "currency",
        "locale",
        "timezone"
      ]
    },
    "observationMethods": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": ["browser", "api", "report", "export"]
          },
          "availability": {
            "enum": ["available", "unavailable", "unknown"]
          },
          "notes": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": ["kind", "availability", "notes"]
      },
      "minItems": 1
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "goals": {
            "type": "array",
            "items": {
              "enum": ["workflow", "saved_data", "interfaces", "appearance"]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "status": {
            "enum": ["planned", "recorded", "verified", "unknown"]
          },
          "casePath": {
            "type": ["string", "null"]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "question",
          "goals",
          "status",
          "casePath",
          "evidence",
          "limitations"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": ["recorded", "verified"]
                }
              }
            },
            "then": {
              "properties": {
                "evidence": {
                  "minItems": 1,
                  "type": "array"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "verified"
                }
              }
            },
            "then": {
              "properties": {
                "casePath": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "externalDependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "mode": {
            "enum": ["observed", "simulated", "untested"]
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0
          }
        },
        "required": ["name", "mode", "scope", "evidence"],
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "enum": ["observed", "simulated"]
                }
              }
            },
            "then": {
              "properties": {
                "evidence": {
                  "minItems": 1,
                  "type": "array"
                }
              }
            }
          }
        ]
      },
      "minItems": 0
    },
    "experiments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "workflowId": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uncertainty": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "proposedObservation": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "enum": ["planned", "resolved"]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "workflowId",
          "uncertainty",
          "proposedObservation",
          "status",
          "evidence"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "resolved"
                }
              }
            },
            "then": {
              "properties": {
                "evidence": {
                  "type": "array",
                  "minItems": 1
                }
              }
            }
          }
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "version",
    "profileId",
    "setup",
    "observationMethods",
    "workflows",
    "externalDependencies",
    "experiments"
  ],
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "enum": ["observed", "caller_declared", "unknown"]
        },
        "value": {
          "type": ["string", "null"]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0
        }
      },
      "required": ["provenance", "value", "evidence"],
      "allOf": [
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "evidence": {
                "maxItems": 0,
                "type": "array"
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "observed"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1,
                "type": "array"
              }
            }
          }
        }
      ]
    }
  }
}
